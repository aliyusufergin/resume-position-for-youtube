{
  "manifest_version": 3,
  "name": "Resume Position for YouTube",
  "version": "1.1.0",
  "description": "Pick up YouTube videos where you left off, even with watch history turned off. Positions stay in your browser; nothing is sent anywhere.",
  "icons": {
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "@yt-resume-local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.youtube.com/*"
  ],
  "incognito": "not_allowed",
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "src/logic.js",
        "src/bridge.js",
        "src/thumbs.js"
      ],
      "run_at": "document_start",
      "css": [
        "src/thumbs.css"
      ]
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "src/logic.js",
        "src/page.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
